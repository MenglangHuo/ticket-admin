# ==========================================================
# TicketAdmin — Production Environment (Live Release domain)
# ==========================================================
VITE_APP_ENV=production
VITE_PORT=4000

# e.g., https://api.ticket-api.site
VITE_PROXY_TARGET=https://apix.site

# Relative API paths routed via production Nginx reverse proxy
VITE_API_BASE_URL=/api
VITE_AUTH_BASE_URL=

# Backend Application Secret for initial access token (POST /token)
VITE_API_SECRET=

# Client Ticket Ingestion Portal Credentials (X-Client-ID & X-Client-Secret)
VITE_CLIENT_ID=client_id
VITE_CLIENT_SECRET=secret_z650sknysn8xadup

# Mock Data Mode (strictly false in production)
VITE_ENABLE_MOCK_DATA=false
