# ==========================================================
# TicketAdmin — Production Environment (Live Release)
# ==========================================================
VITE_APP_ENV=production
VITE_PORT=4000

# Live Production API Base URL & Dev Proxy Target
VITE_PROXY_TARGET=https://apix.bronxtechnology.site

# Client credentials for production
VITE_CLIENT_ID=
VITE_CLIENT_SECRET=
VITE_TELEGRAM_BOT_USERNAME=

# Mock Data Mode (strictly false in production)
VITE_ENABLE_MOCK_DATA=false
