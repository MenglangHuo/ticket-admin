# ==========================================================
# TicketAdmin — Development Environment (Local)
# ==========================================================
VITE_APP_ENV=development
VITE_PORT=4000

# Backend target for Vite dev reverse proxy (http://127.0.0.1:8000)
VITE_PROXY_TARGET=http://127.0.0.1:8000

# Relative API paths routed via Vite dev server proxy to 127.0.0.1:8000
VITE_API_BASE_URL=/api
VITE_AUTH_BASE_URL=
VITE_ENABLE_MOCK_DATA=false


