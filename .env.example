# ==========================================
# TicketAdmin — Environment Configuration
# ==========================================

# Base API endpoint for backend service (REST / Laravel API)
# Defaults to http://127.0.0.1:8000/api/v1
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Authentication endpoint URL (root host without /api prefix)
# Used for /token, /login, and /two-factor endpoints
VITE_AUTH_BASE_URL=http://127.0.0.1:8000

# Application secret key for generating initial API access tokens via POST /token
VITE_API_SECRET=your_backend_api_secret_here

# External Client Ingestion Portal Credentials (used by /client-ticket and client integrations)
VITE_CLIENT_ID=bronx_client_default
VITE_CLIENT_SECRET=bronx_client_secret_default

# Telegram Notification Bot Username (without @ symbol, or with @)
VITE_TELEGRAM_BOT_USERNAME=BronxTicketAlertBot
