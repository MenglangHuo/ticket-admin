# ==========================================
# TicketAdmin — Environment Configuration
# ==========================================

# Local Vite dev server port (http://localhost:4000)
VITE_PORT=4000

# Backend target for Vite dev reverse proxy (all requests to localhost:4000 are forwarded here)
VITE_PROXY_TARGET=http://127.0.0.1:8000

# Base API endpoint for backend service (relative '/api' routes via reverse proxy)
VITE_API_BASE_URL=/api

# Authentication endpoint URL (leave empty when using reverse proxy)
VITE_AUTH_BASE_URL=

# Application secret key for generating initial API access tokens via POST /token
VITE_API_SECRET=your_backend_api_secret_here

# External Client Ingestion Portal Credentials (used by /client-ticket and client integrations)
VITE_CLIENT_ID=bronx_client_default
VITE_CLIENT_SECRET=bronx_client_secret_default

# Telegram Notification Bot Username (without @ symbol, or with @)
VITE_TELEGRAM_BOT_USERNAME=BronxTicketAlertBot

# Mock Data Configuration
# Set to 'true' to run the admin frontend with realistic mock data for all pages (Tickets, Dashboard, Settings, Clients, etc.)
# Set to 'false' to communicate directly with live Laravel API endpoints
VITE_ENABLE_MOCK_DATA=true
# Backward-compatible alias:
# VITE_USE_MOCK_DATA=true
