# ==========================================================
# TicketAdmin — Environment Configuration Reference
# ==========================================================
#
# Active Environment Identifier ('development' | 'production' | 'mock')
VITE_APP_ENV=development

# Local Vite dev server and preview port (http://localhost:4000)
VITE_PORT=4000

# Optional Host binding (e.g. '0.0.0.0' or 'localhost')
# VITE_HOST=0.0.0.0

# Backend target for Vite dev reverse proxy (all requests to localhost:4000 are forwarded here)
# Development: http://127.0.0.1:8000
# Production:  real domain (e.g., https://api.ticket-api.site) or leave empty when behind Nginx reverse proxy
VITE_PROXY_TARGET=http://127.0.0.1:8000

# Reverse Proxy Toggle (set to 'false' to bypass Vite proxy and use direct absolute URLs)
# VITE_USE_PROXY=true

# Base API endpoint for backend service (relative '/api' routes via reverse proxy)
VITE_API_BASE_URL=/api

# Authentication endpoint URL (leave empty when using reverse proxy)
VITE_AUTH_BASE_URL=

# Application secret key for generating initial API access tokens via POST /token
VITE_API_SECRET=your_backend_api_secret_here

# External Client Ingestion Portal Credentials (used by /client-ticket and client integrations)
VITE_CLIENT_ID=5ECCC503325C7
VITE_CLIENT_SECRET=4d2aff85f39fa8686b8abad8bdd2367f22b5fd915ef4f24a1a21239987a1c29c

# Mock Data Configuration
# Set to 'true' to run the admin frontend with realistic mock data for all pages (Tickets, Dashboard, Settings, Clients, etc.)
# Set to 'false' to communicate directly with live Laravel API endpoints
VITE_ENABLE_MOCK_DATA=false
