# ==========================================================
# TicketAdmin — Mock Data Sandbox Mode
# ==========================================================
VITE_APP_ENV=mock
VITE_PORT=4000

# Reverse proxy is disabled in mock sandbox (mock data runs in-memory client-side)
VITE_PROXY_TARGET=

# Standalone mock in-memory endpoints
VITE_API_BASE_URL=/api
VITE_AUTH_BASE_URL=

# Backend Application Secret (mock bypass)
VITE_API_SECRET=mock_secret_key

# Mock Data Mode (strictly enabled)
VITE_ENABLE_MOCK_DATA=true
